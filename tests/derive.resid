// derive.resid — instances generated by resid-derive, run over CBOR. The
// point is not the derive itself (resid-serial tests that) but that the
// generated code needs nothing from a format beyond the protocol, so the
// same instances work here.

import "../src/json.resid";
import "model_serial.resid";
import "check.resid";

Str cfg_text(Config c) {
    Result(Str, SerialError) r = to_json(c);
    return text_of(r);
}

Str config_err(Result(Config, SerialError) r) {
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(c) = r) { return f"{c.host_name}/{c.login_count}"; }
    return "unreachable";
}

Str config_text(Str body) {
    Result(Config, SerialError) r = from_json(body);
    return config_err(r);
}

Str event_text(Str body) {
    Result(Event, SerialError) r = from_json(body);
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(ev) = r) { return show_event(ev); }
    return "unreachable";
}

Str show_event(Event ev) {
    Event e = ev;
    return match e {
        Started(c) => f"Started({c.host_name})",
        Stopped => "Stopped"
    };
}

Str meters_text(Str body) {
    Result(Meters, SerialError) r = from_json(body);
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(m) = r) { return f"{m.value}"; }
    return "unreachable";
}

Str loose_text(Str body) {
    Result(Loose, SerialError) r = from_json(body);
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(l) = r) { return match l { Num(n) => f"Num({n})", Word(s) => f"Word({s})", Nothing => "Nothing" }; }
    return "unreachable";
}

Int main() {
    Option(Str) some_mail = Some("a@b");
    Config c = Config {.host_name = "example.com", .login_count = 3, .email = some_mail, .secret = "hunter2"};

    // rename_all camelCase, rename, skip, and the field order as written.
    // The fields in declaration order, each name as a JSON key.
    check_text("config/text", cfg_text(c), "{\"hostname\":\"example.com\",\"loginCount\":3,\"email\":\"a@b\"}");

    // Round trip, and the alias on decode.
    check_text("config/back", config_text(cfg_text(c)), "example.com/3");
    check_text("config/alias", config_text("{\"server\":\"example.com\",\"loginCount\":3,\"email\":\"a@b\"}"), "example.com/3");

    // An absent Option field decodes as None; a default fills in.
    check_text("config/minimal", config_text("{\"hostname\":\"example.com\"}"), "example.com/0");

    // skip_encoding_if drops the field entirely.
    Option(Str) no_mail = None;
    Config bare = Config {.host_name = "h", .login_count = 1, .email = no_mail, .secret = "s"};
    check_text("config/skipped", cfg_text(bare), "{\"hostname\":\"h\",\"loginCount\":1}");

    // deny_unknown_fields.
    Result(Config, SerialError) unknown = from_json("{\"hostname\":\"example.com\",\"loginCount\":3,\"zzz\":1}");
    check_text("config/deny unknown", config_err(unknown), "decode: unknown field `zzz`, expected `hostname`, `server`, `loginCount` or `email`");

    // An internally tagged enum: the tag and the payload share one object.
    check_text("event/started", text_of(to_json(Started(bare))), "{\"kind\":\"started\",\"hostname\":\"h\",\"loginCount\":1}");
    check_text("event/stopped", text_of(to_json(Stopped)), "{\"kind\":\"stopped\"}");
    check_text("event/back", event_text("{\"kind\":\"started\",\"hostname\":\"h\",\"loginCount\":1}"), "Started(h)");
    check_text("event/unit back", event_text("{\"kind\":\"stopped\"}"), "Stopped");
    check_text("event/unknown kind", event_text("{\"kind\":\"coop\"}"), "decode: unknown variant `coop`, expected `started` or `stopped`");

    // transparent: one field, no wrapper.
    check_text("meters", text_of(to_json(Meters {.value = 1.5})), "1.5");
    check_text("meters/back", meters_text("1.5"), "1.5");

    // untagged: the payload alone, tried in order.
    check_text("loose/num", loose_text("5"), "Num(5)");
    check_text("loose/word", loose_text("\"word\""), "Word(word)");
    check_text("loose/nothing", loose_text("null"), "Nothing");
    check_text("loose/ambiguous", loose_text("5"), "Num(5)");

    return 0;
}